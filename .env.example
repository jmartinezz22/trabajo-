# Dominio público definitivo (canonical, Open Graph, sitemap)
SITE_URL=https://www.dominio-definitivo.es

# Endpoint que recibe el formulario de propuesta (POST JSON).
# Ej.: Formspree, HubSpot Forms API, función serverless o CRM propio.
PUBLIC_FORM_ENDPOINT=

# ——— Catálogo ———
# CONTACT_EMAIL de la versión neutra / white label (vacío = se muestra [PENDIENTE DE CONFIRMAR])
PUBLIC_CONTACT_EMAIL=
# Sustituye el email de la versión PALEX (por defecto: palexmedical@palex.es)
PUBLIC_PALEX_CONTACT_EMAIL=
# Versiones del catálogo a generar: "palex,neutro" (por defecto) o solo "neutro"
# para publicar el white label en un dominio independiente.
PUBLIC_CATALOGS=
