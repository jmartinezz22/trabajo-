---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FeaturedCase from '@/components/FeaturedCase.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { featuredCase, pendingCases } from '@/data/cases';

const crumbs = [{ name: 'Proyectos', href: '/proyectos/' }];
---
<BaseLayout
  title="Proyectos y casos de éxito logísticos"
  description="Caso real: automatización y trazabilidad de 176 almacenes en el Hospital Sant Joan de Déu de Barcelona con RFID, Dyane SmartKanban, SmartCabinet y Captis."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Proyectos"
    title="Cada proyecto empieza con un reto concreto."
    intro="Documentamos nuestro trabajo con una estructura sencilla: qué necesitaba el cliente, qué diseñamos y qué se consiguió. Sin cifras que no podamos demostrar."
    breadcrumbs={crumbs}
  >
    <a href="/contacto/" class="btn">Cuéntanos tu reto <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Caso de éxito</p>
        <h2 data-reveal style="--reveal-i:1">Automatización y digitalización logística hospitalaria</h2>
      </div>
      <FeaturedCase c={featuredCase} />
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Otros proyectos</p>
          <h2 data-reveal style="--reveal-i:1">Experiencia en optimización logística</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Proyectos identificados en fuentes públicas. Se completarán con cliente, alcance y resultados una vez validados internamente.
        </p>
      </div>
      <div class="grid grid-3">
        {pendingCases.map((c, i) => <CaseCard c={c} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBand title="Tu proyecto puede ser el siguiente." text="Explícanos tu operación y diseñamos la solución." />
</BaseLayout>
