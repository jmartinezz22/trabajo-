---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { cases } from '@/data/cases';

const crumbs = [{ name: 'Proyectos', href: '/proyectos/' }];
---
<BaseLayout
  title="Proyectos logísticos"
  description="Proyectos de transporte, almacenaje, eventos, excedentes y consultoría logística: reto, solución y resultado."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Proyectos"
    title="Cada proyecto empieza con un reto concreto."
    intro="Documentamos nuestro trabajo con una estructura sencilla: qué necesitaba el cliente, qué diseñamos y qué se consiguió."
    breadcrumbs={crumbs}
  >
    <a href="/contacto/" class="btn">Cuéntanos tu reto <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <p class="pending notice">
        Los casos siguientes son plantillas ilustrativas. Se sustituirán por proyectos reales de PALEX MEDICAL (anonimizados o con autorización del cliente).
      </p>
      <div class="grid grid-3">
        {cases.map((c, i) => <CaseCard {...c} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBand title="Tu proyecto puede ser el siguiente." text="Explícanos tu operación y diseñamos la solución." />
</BaseLayout>

<style>
  .notice { display: block; margin-bottom: var(--space-6); padding: var(--space-3) var(--space-4); font-size: var(--fs-sm); }
</style>
