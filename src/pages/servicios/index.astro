---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceIndex from '@/components/ServiceIndex.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';

const crumbs = [{ name: 'Servicios', href: '/servicios/' }];
---
<BaseLayout
  title="Servicios logísticos para empresas"
  description="Transporte, logística y fulfillment, servicios especiales, eventos y congresos, excedentes industriales y consultoría logística. Seis líneas de servicio combinables."
  breadcrumbs={crumbs}
  overlay
>
  <PageHero
    eyebrow="Servicios"
    title="Seis líneas de servicio. Una operación coordinada."
    intro="Contrata un servicio concreto o combina varios para cubrir toda la cadena, con un único interlocutor."
    breadcrumbs={crumbs}
    image="logistica"
  >
    <a href="/contacto/" class="btn">Solicitar una solución <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container"><ServiceIndex /></div>
  </section>

  <section class="section bg-stone">
    <div class="container narrow combine">
      <p class="eyebrow" data-reveal>Combinables</p>
      <p class="big" data-reveal style="--reveal-i:1">Lo habitual no es necesitar un servicio. Es necesitar varios que funcionen como uno solo.</p>
      <p class="lead" data-reveal style="--reveal-i:2">
        Almacenaje con transporte refrigerado. Preparación de material con montaje en un congreso. Consultoría de layout con montaje de estanterías. Diseñamos la combinación y la coordinamos.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .combine { display: grid; gap: var(--space-6); }
  .big { font-family: var(--font-display); font-size: clamp(2rem, 1.3rem + 2.8vw, 3.75rem); letter-spacing: -0.035em; line-height: 1.08; color: var(--ink); }
</style>
