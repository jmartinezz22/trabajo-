---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectorGrid from '@/components/SectorGrid.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';

const crumbs = [{ name: 'Sectores', href: '/sectores/' }];
---
<BaseLayout
  title="Sectores · Logística farmacéutica, industrial, e-commerce y eventos"
  description="Logística para pharma y healthcare, industria, tecnología, e-commerce, distribución, eventos y congresos y equipamiento profesional. Qué problema logístico resolvemos en cada sector."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Sectores"
    title="Cada sector tiene su problema logístico. Lo conocemos."
    intro="Seleccionamos los sectores en los que nuestras capacidades —temperatura controlada, almacenaje, fulfillment, equipos de alto valor, eventos y consultoría— resuelven necesidades concretas."
    breadcrumbs={crumbs}
  >
    <a href="/contacto/" class="btn">Solicitar propuesta <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <h2 class="visually-hidden">Sectores que atendemos</h2>
      <SectorGrid detailed />
    </div>
  </section>

  <CtaBand title="¿Tu sector no aparece?" text="Si tu operación tiene requisitos particulares, la analizamos y diseñamos una solución específica." />
</BaseLayout>
