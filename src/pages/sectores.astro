---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectorList from '@/components/SectorList.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';

const crumbs = [{ name: 'Sectores', href: '/sectores/' }];
---
<BaseLayout
  title="Sectores · Logística farmacéutica, hospitalaria, industrial, e-commerce y eventos"
  description="Logística para pharma y healthcare, industria, tecnología, e-commerce, distribución, eventos y congresos y equipamiento profesional. Qué problema logístico resolvemos en cada sector."
  breadcrumbs={crumbs}
  overlay
>
  <PageHero
    eyebrow="Sectores"
    title="Cada sector tiene su problema logístico."
    intro="Temperatura controlada, trazabilidad, equipos de alto valor, picos de demanda o fechas inamovibles. Así lo resolvemos en cada caso."
    breadcrumbs={crumbs}
    image="pharma"
  >
    <a href="/contacto/" class="btn">Solicitar una solución <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <h2 class="visually-hidden">Sectores que atendemos</h2>
      <SectorList detailed />
    </div>
  </section>

  <CtaBand title="¿Tu sector no aparece?" text="Si tu operación tiene requisitos particulares, la analizamos y diseñamos una solución específica." />
</BaseLayout>
