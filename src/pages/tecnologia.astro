---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TechGrid from '@/components/TechGrid.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Visual from '@/components/Visual.astro';
import { ownSolutions } from '@/data/technology';

const crumbs = [{ name: 'Tecnología', href: '/tecnologia/' }];
---
<BaseLayout
  title="Tecnología logística · Automatización, RFID, trazabilidad y SAP HANA"
  description="Automatización de almacenes, trazabilidad RFID, soluciones Dyane SmartKanban, SmartCabinet y Captis, control de impactos y experiencia en SAP HANA y SAP EWM."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Tecnología"
    title="Experiencia en automatización y trazabilidad."
    intro="La operación física respaldada por tecnología: RFID, soluciones propias de gestión de almacenes, control de impactos y experiencia en SAP HANA y EWM."
    breadcrumbs={crumbs}
    image="tecnologia"
  >
    <a href="/contacto/?servicio=consultoria-logistica" class="btn">Hablar con un especialista <Icon name="arrow" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Capacidades</p>
          <h2 data-reveal style="--reveal-i:1">Qué controlamos y cómo</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Las herramientas concretas de cada operación se definen en la fase de diseño, según los sistemas del cliente.
        </p>
      </div>
      <TechGrid tone="light" showDetail />
    </div>
  </section>

  <section class="section on-dark">
    <div class="container own">
      <div>
        <p class="eyebrow" data-reveal>Soluciones propias</p>
        <h2 data-reveal style="--reveal-i:1">Desarrolladas con nuestra experiencia en logística hospitalaria.</h2>
        <p class="lead" data-reveal style="--reveal-i:2">
          Tecnología RFID aplicada a la gestión de almacenes, la reposición y el control de material de alto valor. Implantada, entre otros, en los 176 almacenes del Hospital Sant Joan de Déu.
        </p>
        <a href="/proyectos/#hospital-sant-joan-de-deu" class="link-arrow" data-reveal>Ver el caso <Icon name="arrow" /></a>
      </div>
      <ul role="list" class="own-list">
        {ownSolutions.map((o, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{o.name}</h3>
            <p>{o.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container sap">
      <div data-reveal><Visual image="logistica2" ratio="landscape" kenburns /></div>
      <div class="sap-copy">
        <p class="eyebrow" data-reveal>SAP HANA · SAP EWM</p>
        <h2 data-reveal style="--reveal-i:1">Logística y sistemas, en la misma conversación.</h2>
        <p class="lead" data-reveal style="--reveal-i:2">
          Contamos con experiencia en la implantación de SAP HANA y del módulo de gestión de almacenes EWM en centros propios. Ese conocimiento nos permite alinear procesos logísticos y sistema desde el diseño de la operación.
        </p>
        <a href="/servicios/consultoria-logistica/" class="link-arrow" data-reveal>Ver consultoría logística <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand title="¿Necesitas más control sobre tu operación?" text="Cuéntanos qué quieres trazar, automatizar o integrar." />
</BaseLayout>

<style>
  .own { display: grid; gap: var(--space-7); }
  .own > div:first-child { display: grid; gap: var(--space-5); justify-items: start; align-content: start; }
  .own h2 { max-width: 22ch; }
  .own-list { border-top: 1px solid var(--ink-3); }
  .own-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 0.25rem var(--space-4); padding: var(--space-5) 0; border-bottom: 1px solid var(--ink-3); }
  .own-list .mono { color: var(--brand); grid-row: span 2; padding-top: 0.3rem; }
  .own-list p { color: var(--text-on-dark-muted); font-size: var(--fs-sm); }
  .sap { display: grid; gap: var(--space-7); align-items: center; }
  .sap-copy { display: grid; gap: var(--space-5); justify-items: start; }
  @media (min-width: 1024px) {
    .own { grid-template-columns: 1fr 1fr; gap: var(--space-9); }
    .sap { grid-template-columns: 1fr 1fr; gap: var(--space-9); }
  }
</style>
