---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FeaturedCase from '@/components/FeaturedCase.astro';
import CaseRow from '@/components/CaseRow.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { featuredCase, pendingCases } from '@/data/cases';

const crumbs = [{ name: 'Proyectos', href: '/proyectos/' }];
---
<BaseLayout
  title="Proyectos y casos de éxito logísticos"
  description="Caso real: automatización y trazabilidad de 176 almacenes en el Hospital Sant Joan de Déu de Barcelona con RFID y soluciones Dyane."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Proyectos"
    title="Cada proyecto empieza con un reto concreto."
    intro="Qué necesitaba el cliente, qué diseñamos y qué se consiguió. Sin cifras que no podamos demostrar."
    breadcrumbs={crumbs}
  >
    <a href="/contacto/" class="btn">Cuéntanos tu reto <Icon name="arrow" /></a>
  </PageHero>

  <section class="section bg-surface">
    <div class="container"><FeaturedCase c={featuredCase} /></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Otros proyectos</p>
          <h2 data-reveal style="--reveal-i:1">Experiencia en optimización logística.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">Proyectos identificados en fuentes públicas, pendientes de validar cliente, alcance y resultados.</p>
      </div>
      <ul role="list" class="rows">
        {pendingCases.map((c, i) => <CaseRow c={c} index={i} />)}
      </ul>
    </div>
  </section>

  <CtaBand title="Tu proyecto puede ser el siguiente." />
</BaseLayout>

<style>
  .rows { border-top: 1px solid var(--line); }
</style>
