---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FlowSteps from '@/components/FlowSteps.astro';
import EditorialList from '@/components/EditorialList.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { methodSteps } from '@/data/navigation';

const crumbs = [{ name: 'Soluciones a medida', href: '/soluciones-a-medida/' }];

const signals = [
  'Tu mercancía necesita condiciones que un servicio estándar no garantiza.',
  'Coordinas almacenaje, transporte y manipulados con varios proveedores que no se hablan entre sí.',
  'Tienes picos, campañas o eventos con fechas que no se pueden mover.',
  'Tu almacén se ha quedado pequeño o desordenado y no sabes si el problema es espacio o proceso.',
  'Tienes stock o material sin salida ocupando espacio y capital.',
  'Necesitas que la logística se integre con tus sistemas.',
];
const deliverables = [
  { title: 'Diagnóstico de la operación', text: 'Situación actual, restricciones y oportunidades.' },
  { title: 'Diseño de la solución', text: 'Procesos, recursos, transporte y sistemas implicados.' },
  { title: 'Plan de implantación', text: 'Fases, responsables y calendario de puesta en marcha.' },
  { title: 'Indicadores de seguimiento', text: 'Qué se mide y cómo se revisa la operación.' },
];
---
<BaseLayout
  title="Soluciones logísticas a medida"
  description="Analizamos tu operación, identificamos las necesidades y diseñamos una solución logística adaptada. Después la implantamos, gestionamos y optimizamos."
  breadcrumbs={crumbs}
  overlay
>
  <PageHero
    eyebrow="Soluciones a medida"
    title="Tu operación. Nuestra solución."
    intro="Analizamos tu operación, identificamos las necesidades y diseñamos una solución adaptada. Después la implantamos, la gestionamos y la optimizamos."
    breadcrumbs={crumbs}
    image="consultoria"
  >
    <a href="/contacto/?servicio=solucion-a-medida" class="btn">Cuéntanos tu proyecto <Icon name="arrow" /></a>
  </PageHero>

  <section class="section bg-stone">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Método</p>
        <h2 data-reveal style="--reveal-i:1">Cinco fases. Un responsable.</h2>
      </div>
      <FlowSteps steps={methodSteps} showText />
    </div>
  </section>

  <section class="section on-dark">
    <div class="container signals">
      <div>
        <p class="eyebrow" data-reveal>Señales</p>
        <h2 data-reveal style="--reveal-i:1">Cuándo necesitas una solución a medida.</h2>
      </div>
      <ol role="list">
        {signals.map((s, i) => (
          <li data-reveal style={`--reveal-i:${i % 3}`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{s}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Entregables</p>
        <h2 data-reveal style="--reveal-i:1">Qué recibes.</h2>
      </div>
      <EditorialList items={deliverables} />
    </div>
  </section>

  <CtaBand title="Cuéntanos tu proyecto." href="/contacto/?servicio=solucion-a-medida" label="Cuéntanos tu proyecto" />
</BaseLayout>

<style>
  .signals { display: grid; gap: var(--space-8); }
  .signals h2 { max-width: 14ch; }
  .signals ol { border-top: 1px solid var(--ink-3); }
  .signals li { display: grid; grid-template-columns: 3.5rem 1fr; padding: var(--space-5) 0; border-bottom: 1px solid var(--ink-3); font-size: var(--fs-md); color: #e3e8e8; }
  .signals .n { font-size: var(--fs-sm); color: var(--text-on-dark-muted); padding-top: 0.2rem; }
  @media (min-width: 1024px) { .signals { grid-template-columns: 1fr 1.4fr; gap: var(--space-9); } }
</style>
