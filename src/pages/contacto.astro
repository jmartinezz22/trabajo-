---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import { site, telHref, formatAddress, PENDING } from '@/data/site';

const crumbs = [{ name: 'Contacto', href: '/contacto/' }];
const { contact } = site;

const steps = [
  'Revisamos tu solicitud y, si hace falta, te pedimos más detalle.',
  'Analizamos la operación: mercancía, volúmenes, plazos y requisitos.',
  'Te presentamos una propuesta de solución y su alcance.',
];
---
<BaseLayout
  title="Solicitar propuesta logística"
  description="Cuéntanos tu operación: servicio, origen, destino, tipo de mercancía y necesidades especiales. Diseñamos una propuesta logística adaptada."
  breadcrumbs={crumbs}
  hideStickyCta
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Solicitar propuesta', url: new URL('/contacto/', Astro.site).href }]}
>
  <section class="contact">
    <div class="container grid-c">
      <div class="intro on-dark">
        <nav aria-label="Ruta de navegación" class="crumbs">
          <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Contacto</span>
        </nav>
        <p class="eyebrow">¿Hablamos de tu proyecto?</p>
        <h1>Cuéntanos qué necesitas.</h1>
        <p class="lead">Un servicio puntual o una operación completa. Cuanto más concreta sea la información, más precisa será la propuesta.</p>
      </div>

      <div class="form-wrap">
        <h2 class="h3">Solicitar propuesta</h2>
        <ContactForm />
      </div>

      <aside class="extra on-dark" aria-label="Qué ocurre después y contacto directo">
        <p class="mono label">Qué ocurre después</p>
        <ol role="list" class="next">
          {steps.map((s, i) => (
            <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><p>{s}</p></li>
          ))}
        </ol>

        <ul role="list" class="direct">
          {[contact.phone, contact.customerService].map((p) => (
            <li>
              <Icon name="phone" size={18} />
              <span><span class="sub">{p.label}</span><a href={telHref(p.number)}>{p.number}</a></span>
            </li>
          ))}
          <li>
            <Icon name="mail" size={18} />
            {contact.email ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <span class="pending">Email {PENDING}</span>}
          </li>
          {site.locations.map((l) => (
            <li>
              <Icon name="pin" size={18} />
              <span>
                <span class="sub">{l.label}</span>
                {formatAddress(l.address)}
                {l.phone && <><br /><a href={telHref(l.phone.number)}>{l.phone.number}</a></>}
              </span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-block: 0 var(--section-y); }
  .grid-c { display: grid; padding-inline: 0; }
  .intro, .extra { display: grid; gap: var(--space-5); align-content: start; padding: var(--space-7) var(--gutter); }
  .crumbs { font-size: var(--fs-sm); color: var(--text-on-dark-muted); margin-bottom: var(--space-2); }
  .crumbs a:hover { color: #fff; }
  .intro h1 { font-size: var(--fs-2xl); }
  .label { color: var(--brand); text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--fs-xs); }
  .next { display: grid; gap: var(--space-4); }
  .next li { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--space-3); font-size: var(--fs-sm); color: #dbe3e3; }
  .next .mono { color: var(--brand); }
  .direct { display: grid; gap: var(--space-3); padding-top: var(--space-5); border-top: 1px solid var(--ink-3); font-size: var(--fs-sm); }
  .direct li { display: grid; grid-template-columns: 18px 1fr; gap: var(--space-3); align-items: start; }
  .direct :global(svg) { color: var(--brand); margin-top: 2px; }
  .direct a:hover { color: var(--brand); }
  .sub { display: block; font-size: var(--fs-xs); color: var(--text-on-dark-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .form-wrap { padding: var(--space-7) var(--gutter); }
  .form-wrap h2 { margin-bottom: var(--space-6); }
  @media (min-width: 1024px) {
    .contact { padding-top: var(--space-6); }
    .grid-c {
      grid-template-columns: 5fr 7fr;
      grid-template-areas: 'intro form' 'extra form';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-8);
      padding-inline: var(--gutter);
    }
    .intro { grid-area: intro; padding: var(--space-7) var(--space-7) var(--space-5); border-radius: var(--radius) var(--radius) 0 0; }
    .extra { grid-area: extra; align-self: start; padding: var(--space-5) var(--space-7) var(--space-7); border-radius: 0 0 var(--radius) var(--radius); }
    .form-wrap { grid-area: form; padding: var(--space-6) 0 0; }
  }
</style>
