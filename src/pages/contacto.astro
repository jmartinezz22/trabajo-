---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site, telHref, formatAddress } from '@/data/site';

const crumbs = [{ name: 'Contacto', href: '/contacto/' }];
const { contact } = site;
const steps = [
  'Revisamos tu solicitud y, si hace falta, te pedimos más detalle.',
  'Analizamos la operación: mercancía, volúmenes, plazos y requisitos.',
  'Te presentamos una propuesta de solución y su alcance.',
];
---
<BaseLayout
  title="Solicitar una solución logística"
  description="Cuéntanos tu operación: servicio, origen, destino, tipo de mercancía y necesidades especiales. Diseñamos una propuesta logística adaptada."
  breadcrumbs={crumbs}
  hideStickyCta
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Solicitar una solución', url: new URL('/contacto/', Astro.site).href }]}
>
  <section class="contact">
    <div class="container grid-c">
      <div class="intro">
        <nav aria-label="Ruta de navegación" class="crumbs"><a href="/">Inicio</a> / <span aria-current="page">Contacto</span></nav>
        <p class="eyebrow">¿Hablamos de tu proyecto?</p>
        <h1>Cuéntanos qué necesitas.</h1>
        <p class="lead">Describe tu operación y nuestro equipo analizará contigo la solución más adecuada.</p>

        <div class="direct">
          {[contact.phone, contact.customerService].map((p) => (
            <p><span class="sub">{p.label}</span><a href={telHref(p.number)}>{p.number}</a></p>
          ))}
          {contact.email && <p><span class="sub">Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
        </div>

        <div class="after">
          <p class="eyebrow">Qué ocurre después</p>
          <ol role="list">
            {steps.map((s, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
          </ol>
        </div>

        <div class="locs">
          {site.locations.map((l) => (
            <p><span class="sub">{l.label}</span>{formatAddress(l.address)}</p>
          ))}
        </div>
      </div>

      <div class="form-wrap">
        <h2 class="visually-hidden">Formulario de solicitud</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-block: var(--space-7) var(--section-y); }
  .grid-c { display: grid; gap: var(--space-8); }
  .intro { display: grid; gap: var(--space-6); align-content: start; }
  .crumbs { font-size: var(--fs-sm); color: var(--text-muted); margin-bottom: var(--space-5); }
  .intro h1 { font-size: clamp(2.75rem, 1.6rem + 4.6vw, 6rem); max-width: 10ch; }
  .direct { display: grid; gap: var(--space-4); padding-top: var(--space-5); border-top: 1px solid var(--ink); }
  .direct a { font-family: var(--font-display); font-size: var(--fs-xl); letter-spacing: -0.03em; color: var(--ink); }
  .direct a:hover { color: var(--brand-ink); }
  .sub { display: block; font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.2rem; }
  .after ol { margin-top: var(--space-3); }
  .after li { display: grid; grid-template-columns: 2.5rem 1fr; padding: var(--space-3) 0; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); color: var(--text-muted); }
  .after .n { color: var(--text-soft); }
  .locs { display: grid; gap: var(--space-4); font-size: var(--fs-sm); color: var(--text-muted); }
  @media (min-width: 1024px) {
    .grid-c { grid-template-columns: 5fr 7fr; gap: var(--space-9); align-items: start; }
    .form-wrap { padding-top: 6.5rem; }
  }
</style>
