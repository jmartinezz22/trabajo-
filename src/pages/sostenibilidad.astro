---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EditorialList from '@/components/EditorialList.astro';
import CtaBand from '@/components/CtaBand.astro';

const crumbs = [{ name: 'Logística más eficiente', href: '/sostenibilidad/' }];
// Prácticas editables. Sin certificados, emisiones ni porcentajes no confirmados.
const practices = [
  { title: 'Optimización de rutas', text: 'Planificar recorridos para reducir kilómetros en vacío.' },
  { title: 'Consolidación de cargas', text: 'Agrupar envíos para aprovechar mejor cada vehículo.' },
  { title: 'Optimización de espacios', text: 'Diseñar el almacén para usar mejor la superficie disponible.' },
  { title: 'Reducción de desplazamientos', text: 'Coordinar operaciones para evitar viajes innecesarios.' },
  { title: 'Optimización de embalajes', text: 'Embalajes ajustados al producto: menos material y menos volumen.' },
];
---
<BaseLayout
  title="Logística más eficiente"
  description="Optimización de rutas, consolidación de cargas y optimización de espacios y embalajes: prácticas para una logística más eficiente."
  breadcrumbs={crumbs}
  overlay
>
  <PageHero
    eyebrow="Sostenibilidad"
    title="Logística más eficiente."
    intro="La forma más directa de reducir el impacto de una operación es diseñarla mejor: menos kilómetros, menos espacio vacío, menos embalaje innecesario."
    breadcrumbs={crumbs}
    image="transporte"
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Prácticas</p>
        <h2 data-reveal style="--reveal-i:1">Eficiencia desde el diseño de la operación.</h2>
      </div>
      <EditorialList items={practices} />
      <div class="commit">
        <p class="eyebrow">Gestión ambiental</p>
        <p class="code">UNE-EN ISO 14001:2015</p>
        <p><span class="pending">[CERTIFICACIÓN PENDIENTE DE VALIDACIÓN]</span></p>
        <p class="muted">Indicadores ambientales: <span class="pending">[DATOS PENDIENTES DE CONFIRMAR]</span></p>
      </div>
    </div>
  </section>

  <CtaBand title="¿Quieres hacer tu logística más eficiente?" text="Revisamos tus rutas, cargas, espacios y embalajes." href="/contacto/?servicio=consultoria-logistica" />
</BaseLayout>

<style>
  .commit { display: grid; gap: var(--space-3); margin-top: var(--space-9); padding-top: var(--space-6); border-top: 1px solid var(--rule); }
  .code { font-family: var(--font-display); font-size: var(--fs-xl); letter-spacing: -0.03em; color: var(--fg); }
</style>
