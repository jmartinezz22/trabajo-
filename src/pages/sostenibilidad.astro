---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';

const crumbs = [{ name: 'Logística más eficiente', href: '/sostenibilidad/' }];

// Prácticas editables. No se publican certificados, emisiones ni porcentajes sin confirmar.
const practices = [
  { icon: 'route', title: 'Optimización de rutas', text: 'Planificar recorridos para reducir kilómetros en vacío.' },
  { icon: 'groupage', title: 'Consolidación de cargas', text: 'Agrupar envíos para aprovechar mejor cada vehículo.' },
  { icon: 'layout', title: 'Optimización de espacios', text: 'Diseñar el almacén para usar mejor la superficie disponible.' },
  { icon: 'cycle', title: 'Reducción de desplazamientos', text: 'Coordinar operaciones para evitar viajes innecesarios.' },
  { icon: 'package', title: 'Optimización de embalajes', text: 'Embalajes ajustados al producto: menos material y menos volumen.' },
] as const;
---
<BaseLayout
  title="Logística más eficiente"
  description="Optimización de rutas, consolidación de cargas, optimización de espacios y embalajes: prácticas para una logística más eficiente."
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Sostenibilidad"
    title="Logística más eficiente."
    intro="La forma más directa de reducir el impacto de una operación es diseñarla mejor: menos kilómetros, menos espacio vacío, menos embalaje innecesario."
    breadcrumbs={crumbs}
    image="sostenibilidad"
  />

  <section class="section">
    <div class="container">
      <ul role="list" class="practices">
        {practices.map((p, i) => (
          <li data-reveal style={`--reveal-i:${i % 3}`}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="h3">{p.title}</h2>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
      <div class="commit">
        <h2 class="h3">Gestión ambiental</h2>
        <p class="muted">UNE-EN ISO 14001:2015 — Sistema de gestión ambiental.</p>
      </div>
    </div>
  </section>

  <CtaBand title="¿Quieres hacer tu logística más eficiente?" text="Revisamos tus rutas, cargas, espacios y embalajes." href="/contacto/?servicio=consultoria-logistica" />
</BaseLayout>

<style>
  .practices { display: grid; gap: var(--space-7) var(--space-6); }
  .practices li { display: grid; gap: var(--space-3); align-content: start; padding-top: var(--space-5); border-top: 1px solid var(--ink); }
  .practices .mono { color: var(--brand-ink); margin-bottom: var(--space-4); }
  .practices p { font-size: var(--fs-sm); color: var(--text-muted); }
  @media (min-width: 640px) { .practices { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .practices { grid-template-columns: repeat(3, 1fr); } }
  .commit { display: grid; gap: var(--space-4); justify-items: start; margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--line); }
</style>
