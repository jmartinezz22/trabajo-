---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Visual from '@/components/Visual.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FlowSteps from '@/components/FlowSteps.astro';
import SectorGrid from '@/components/SectorGrid.astro';
import TechGrid from '@/components/TechGrid.astro';
import CaseCard from '@/components/CaseCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services, serviceHref } from '@/data/services';
import { methodSteps, valueChain } from '@/data/navigation';
import { cases } from '@/data/cases';
import { site } from '@/data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL('/', Astro.site).href,
    inLanguage: 'es-ES',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios logísticos de PALEX MEDICAL',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(serviceHref(s.slug), Astro.site).href,
    })),
  },
];
---
<BaseLayout
  title="Operador logístico B2B"
  fullTitle="Operador logístico B2B · Soluciones logísticas integrales a medida | PALEX MEDICAL"
  description="Transporte, almacenaje, distribución, servicios especiales, eventos, excedentes industriales y consultoría logística. Soluciones logísticas integrales adaptadas a cada empresa."
  schema={schema}
>
  <!-- 01 — HERO -->
  <section class="hero on-dark">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>Operador logístico B2B</p>
        <h1 data-reveal style="--reveal-i:1">Soluciones logísticas para operaciones que no pueden fallar.</h1>
        <p class="lead" data-reveal style="--reveal-i:2">
          Transporte, almacenaje, distribución y proyectos logísticos a medida para empresas que necesitan algo más que un proveedor.
        </p>
        <div class="btn-row" data-reveal style="--reveal-i:3">
          <a href="/contacto/" class="btn">Solicitar solución logística <Icon name="arrow" /></a>
          <a href="#servicios" class="btn btn-ghost">Conocer nuestros servicios</a>
        </div>
      </div>
      <div class="hero-media" data-reveal style="--reveal-i:2">
        <Visual image="hero" ratio="fill" caption="Fig. 01 — Red de operación" eager parallax />
      </div>
    </div>
    <nav class="container hero-index" aria-label="Líneas de servicio">
      <ul role="list">
        {services.map((s) => (
          <li>
            <a href={serviceHref(s.slug)}>
              <span class="mono">{s.num}</span>
              <span>{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- 02 — CAPACIDAD -->
  <section class="section capacity">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Capacidad</p>
          <h2 data-reveal style="--reveal-i:1">Una solución. Todas las fases de la operación.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          PALEX MEDICAL no se limita a transportar mercancías. Intervenimos en la fase que necesitas o en toda la cadena,
          con un único interlocutor y una operación diseñada para tu negocio.
        </p>
      </div>
      <ol role="list" class="chain" data-draw>
        {valueChain.map((c, i) => (
          <li style={`--i:${i}`}>
            <a href={c.href}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="chain-label">{c.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 — SERVICIOS -->
  <section class="section bg-surface" id="servicios">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Servicios</p>
          <h2 data-reveal style="--reveal-i:1">Seis líneas de servicio. Un único interlocutor.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">Combinables entre sí para cubrir desde una necesidad puntual hasta la externalización completa de tu logística.</p>
          <a href="/servicios/" class="link-arrow">Ver todos los servicios <Icon name="arrow" /></a>
        </div>
      </div>
      <ul role="list" class="service-index">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </ul>
    </div>
  </section>

  <!-- 04 — SOLUCIONES A MEDIDA -->
  <section class="section custom on-dark">
    <div class="container custom-grid">
      <div class="custom-copy">
        <p class="eyebrow" data-reveal>Soluciones a medida</p>
        <h2 data-reveal style="--reveal-i:1">Tu operación. Nuestra solución.</h2>
        <p class="question" data-reveal style="--reveal-i:2">¿Tienes una necesidad logística que no encaja en una solución estándar?</p>
        <p class="lead" data-reveal style="--reveal-i:3">
          Analizamos tu operación, identificamos las necesidades y diseñamos una solución adaptada. Después la implantamos, la gestionamos y la mejoramos.
        </p>
        <div class="btn-row" data-reveal style="--reveal-i:4">
          <a href="/contacto/?servicio=solucion-a-medida" class="btn">Cuéntanos tu proyecto <Icon name="arrow" /></a>
          <a href="/soluciones-a-medida/" class="btn btn-ghost">Cómo trabajamos</a>
        </div>
      </div>
      <div data-reveal style="--reveal-i:2">
        <Visual image="medida" ratio="portrait" caption="Fig. 02 — Diseño de operación" parallax />
      </div>
    </div>
  </section>

  <!-- 05 — SECTORES -->
  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Sectores</p>
          <h2 data-reveal style="--reveal-i:1">Necesidades distintas. La misma exigencia.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">Cada sector plantea un problema logístico diferente. Así lo resolvemos.</p>
          <a href="/sectores/" class="link-arrow">Ver sectores <Icon name="arrow" /></a>
        </div>
      </div>
      <SectorGrid />
    </div>
  </section>

  <!-- 06 — PROCESO -->
  <section class="section bg-surface">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Método</p>
          <h2 data-reveal style="--reveal-i:1">Diseñamos la logística. La ejecutamos. La mejoramos.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Un proceso de cinco fases que convierte una necesidad en una operación estable y medible.
        </p>
      </div>
      <FlowSteps steps={methodSteps} />
    </div>
  </section>

  <!-- 07 — TECNOLOGÍA -->
  <section class="section on-dark">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Tecnología</p>
          <h2 data-reveal style="--reveal-i:1">Control, trazabilidad e integración.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">La operación física se apoya en sistemas y datos. Con experiencia en SAP HANA aplicada a la logística.</p>
          <a href="/tecnologia/" class="link-arrow">Ver tecnología <Icon name="arrow" /></a>
        </div>
      </div>
      <TechGrid />
    </div>
  </section>

  <!-- 08 — PROYECTOS -->
  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Proyectos</p>
          <h2 data-reveal style="--reveal-i:1">Cada proyecto, un reto concreto.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">Reto, solución y resultado. Así documentamos nuestro trabajo.</p>
          <a href="/proyectos/" class="link-arrow">Ver proyectos <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="grid grid-3">
        {cases.map((c, i) => <CaseCard {...c} index={i} />)}
      </div>
    </div>
  </section>

  <!-- 09 — CTA -->
  <CtaBand
    title="Cuéntanos qué necesitas."
    text="Describe tu operación y te propondremos una solución logística adaptada: un servicio concreto o la cadena completa."
    label="Solicitar propuesta"
  />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: var(--space-7); align-items: stretch; }
  .hero-copy { display: grid; gap: var(--space-5); align-content: center; justify-items: start; padding-bottom: var(--space-4); }
  .hero h1 { font-size: clamp(2.375rem, 1.4rem + 3.6vw, 4.75rem); max-width: 17ch; }
  @media (max-width: 520px) {
    .hero-copy .btn-row, .custom-copy .btn-row { width: 100%; }
    .hero-copy .btn-row .btn, .custom-copy .btn-row .btn { flex: 1 1 100%; }
  }
  .hero .lead { color: #c3cfd1; max-width: 46ch; }
  .hero-copy .btn-row { margin-top: var(--space-3); }
  .hero-media { min-height: 300px; }
  .hero-media :global(.visual) { height: 100%; }
  .hero-index { margin-top: var(--space-8); }
  .hero-index ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--ink-3);
  }
  .hero-index a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 1.1rem 0.25rem 1.25rem 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    color: #dbe3e3;
    border-bottom: 1px solid var(--ink-3);
    transition: color var(--dur) var(--ease);
  }
  .hero-index .mono { color: var(--brand); font-size: 0.6875rem; }
  .hero-index a:hover { color: #fff; }
  @media (min-width: 768px) {
    .hero-index ul { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1100px) {
    .hero-grid { grid-template-columns: 1.15fr 1fr; gap: var(--space-8); min-height: min(68vh, 640px); }
    .hero-media { min-height: 0; }
    .hero-index ul { grid-template-columns: repeat(6, 1fr); }
    .hero-index a { border-bottom: 0; padding-bottom: 2rem; }
    .hero-index li + li a { padding-left: 1rem; border-left: 1px solid var(--ink-3); }
  }

  /* CAPACIDAD — cadena de valor */
  .chain {
    position: relative;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .chain li { border-bottom: 1px solid var(--line); }
  .chain a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    transition: color var(--dur) var(--ease), padding var(--dur) var(--ease);
  }
  .chain .mono { color: var(--brand-ink); }
  .chain-label {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .chain a:hover { padding-left: var(--space-3); }
  .chain a:hover .chain-label { color: var(--brand-ink); }
  @media (min-width: 1024px) {
    .chain {
      grid-template-columns: repeat(7, 1fr);
      border-top: 0;
      padding-top: var(--space-6);
    }
    .chain::before,
    .chain::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--line);
    }
    .chain::after {
      background: var(--brand);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 1.8s var(--ease);
    }
    .chain.is-drawn::after { transform: scaleX(1); }
    .chain li { border-bottom: 0; border-left: 1px solid var(--line); }
    .chain a { flex-direction: column; gap: var(--space-6); padding: 0 var(--space-4) var(--space-4); min-height: 9rem; justify-content: space-between; }
    .chain a:hover { padding-left: var(--space-4); background: var(--surface); }
    .chain-label { font-size: var(--fs-md); line-height: 1.2; }
  }

  .head-aside { display: grid; gap: var(--space-4); justify-items: start; }
  .service-index { border-top: 1px solid var(--line); }

  /* SOLUCIONES A MEDIDA */
  .custom-grid { display: grid; gap: var(--space-7); align-items: center; }
  .custom-copy { display: grid; gap: var(--space-5); justify-items: start; }
  .question {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--brand);
    max-width: 30ch;
    letter-spacing: -0.015em;
  }
  @media (min-width: 1024px) {
    .custom-grid { grid-template-columns: 1.2fr 1fr; gap: var(--space-9); }
  }
</style>
