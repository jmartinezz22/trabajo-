---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Visual from '@/components/Visual.astro';
import Photo from '@/components/Photo.astro';
import HeroStory from '@/components/HeroStory.astro';
import VisitSection from '@/components/VisitSection.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FlowSteps from '@/components/FlowSteps.astro';
import SectorGrid from '@/components/SectorGrid.astro';
import TechGrid from '@/components/TechGrid.astro';
import FeaturedCase from '@/components/FeaturedCase.astro';
import ProofBand from '@/components/ProofBand.astro';
import CertList from '@/components/CertList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { services, serviceHref } from '@/data/services';
import { methodSteps, valueChain } from '@/data/navigation';
import { featuredCase } from '@/data/cases';
import { site } from '@/data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL('/', Astro.site).href,
    inLanguage: 'es-ES',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios logísticos',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(serviceHref(s.slug), Astro.site).href,
    })),
  },
];
---
<BaseLayout
  title="Operador logístico B2B"
  fullTitle="Operador logístico B2B · Soluciones logísticas integrales a medida"
  description="Logística, transporte, tecnología y trazabilidad para operaciones complejas. Experiencia en logística hospitalaria desde 1998, automatización y soluciones a medida."
  schema={schema}
  intro
>
  <!-- 01 — PORTADA (clara, narrativa de scroll) -->
  <HeroStory />

  <!-- 02 — EXPERIENCIA (solo datos verificados) -->
  <section class="section tight experience" aria-labelledby="exp-title">
    <div class="container">
      <div class="exp-head">
        <p class="eyebrow" data-reveal>Experiencia demostrable</p>
        <h2 id="exp-title" class="h3" data-reveal style="--reveal-i:1">Experiencia en entornos donde la logística no puede fallar: el hospital.</h2>
      </div>
      <ProofBand />
    </div>
  </section>

  <!-- 03 — CAPACIDAD / PROPUESTA DE VALOR -->
  <section class="section capacity bg-surface">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Propuesta de valor</p>
          <h2 data-reveal style="--reveal-i:1">No solo transportamos. Combinamos todo lo que necesita una operación.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Logística, transporte, tecnología, trazabilidad y consultoría, integradas en una solución diseñada para tu operación y gestionada por un único interlocutor.
        </p>
      </div>
      <ol role="list" class="chain" data-draw>
        {valueChain.map((c, i) => (
          <li style={`--i:${i}`}>
            <a href={c.href}>
              <span class="mono">{i === 0 ? '' : '+ '}{String(i + 1).padStart(2, '0')}</span>
              <span class="chain-label">{c.label}</span>
              <span class="chain-text">{c.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 — SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Servicios</p>
          <h2 data-reveal style="--reveal-i:1">Seis líneas de servicio. Un único interlocutor.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">Combinables entre sí para cubrir desde una necesidad puntual hasta la externalización completa de tu logística.</p>
          <a href="/servicios/" class="link-arrow">Ver todos los servicios <Icon name="arrow" /></a>
        </div>
      </div>
      <ul role="list" class="grid grid-3">
        {services.map((s, i) => <ServiceCard service={s} variant="card" index={i} />)}
      </ul>
    </div>
  </section>

  <!-- 05 — SOLUCIONES A MEDIDA -->
  <section class="section custom on-dark photo-bg">
    <div class="photo-bg__media" aria-hidden="true"><Photo image="medida" kenburns sizes="100vw" /></div>
    <div class="container custom-grid">
      <div class="custom-copy">
        <p class="eyebrow" data-reveal>Soluciones a medida</p>
        <h2 data-reveal style="--reveal-i:1">Tu operación. Nuestra solución.</h2>
        <p class="question" data-reveal style="--reveal-i:2">¿Tienes una necesidad logística que no encaja en una solución estándar?</p>
        <p class="lead" data-reveal style="--reveal-i:3">
          Analizamos tu operación, identificamos las necesidades y diseñamos una solución adaptada. Después la implantamos, la gestionamos y la mejoramos.
        </p>
        <div class="btn-row" data-reveal style="--reveal-i:4">
          <a href="/contacto/?servicio=solucion-a-medida" class="btn">Cuéntanos tu proyecto <Icon name="arrow" /></a>
          <a href="/soluciones-a-medida/" class="btn btn-ghost">Cómo trabajamos</a>
        </div>
      </div>
      <div data-reveal style="--reveal-i:2">
        <Visual image="consultoria" ratio="portrait" caption="Diseño de operación" parallax />
      </div>
    </div>
  </section>

  <!-- 06 — SECTORES -->
  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Sectores</p>
          <h2 data-reveal style="--reveal-i:1">Necesidades distintas. La misma exigencia.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">Cada sector plantea un problema logístico diferente. Así lo resolvemos.</p>
          <a href="/sectores/" class="link-arrow">Ver sectores <Icon name="arrow" /></a>
        </div>
      </div>
      <SectorGrid />
    </div>
  </section>

  <!-- 07 — PROCESO -->
  <section class="section bg-surface">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Método</p>
          <h2 data-reveal style="--reveal-i:1">Diseñamos la logística. La ejecutamos. La mejoramos.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Un proceso de cinco fases que convierte una necesidad en una operación estable y medible.
        </p>
      </div>
      <FlowSteps steps={methodSteps} />
    </div>
  </section>

  <!-- 08 — TECNOLOGÍA -->
  <section class="section on-dark photo-bg">
    <div class="photo-bg__media" aria-hidden="true"><Photo image="logistica2" kenburns sizes="100vw" /></div>
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Tecnología</p>
          <h2 data-reveal style="--reveal-i:1">Automatización, trazabilidad y sistemas.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">RFID, soluciones propias de trazabilidad, control de impactos y experiencia en SAP HANA y EWM: la operación física respaldada por tecnología.</p>
          <a href="/tecnologia/" class="link-arrow">Ver tecnología <Icon name="arrow" /></a>
        </div>
      </div>
      <TechGrid />
    </div>
  </section>

  <!-- 09 — PROYECTOS: caso real -->
  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Caso de éxito</p>
          <h2 data-reveal style="--reveal-i:1">176 almacenes. Un hospital. Trazabilidad de extremo a extremo.</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="lead">Así aplicamos automatización y trazabilidad a una operación logística real y exigente.</p>
          <a href="/proyectos/" class="link-arrow">Ver proyectos <Icon name="arrow" /></a>
        </div>
      </div>
      <FeaturedCase c={featuredCase} />
    </div>
  </section>

  <!-- 10 — CONFIANZA -->
  <section class="section tight bg-surface trust">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Calidad y cumplimiento</p>
          <h2 class="h3" data-reveal style="--reveal-i:1">Sistemas de gestión</h2>
        </div>
        <div class="head-aside" data-reveal style="--reveal-i:2">
          <p class="muted">Calidad, gestión ambiental, prevención del soborno y compliance penal.</p>
          <a href="/empresa/#calidad" class="link-arrow">Más sobre nuestra experiencia <Icon name="arrow" /></a>
        </div>
      </div>
      <CertList />
    </div>
  </section>

  <!-- 11 — UBICACIÓN Y HORARIO -->
  <VisitSection />

  <!-- 12 — CTA -->
  <CtaBand
    title="Cuéntanos qué necesitas."
    text="Describe tu operación y te propondremos una solución logística adaptada: un servicio concreto o la cadena completa."
    label="Solicitar propuesta"
    image="transporte2"
  />
</BaseLayout>

<style>
  @media (max-width: 520px) {
    .custom-copy .btn-row { width: 100%; }
    .custom-copy .btn-row .btn { flex: 1 1 100%; }
  }

  /* CAPACIDAD — cadena de valor */
  .chain {
    position: relative;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .chain li { border-bottom: 1px solid var(--line); }
  .chain a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    transition: color var(--dur) var(--ease), padding var(--dur) var(--ease);
  }
  .chain .mono { color: var(--brand-ink); }
  .chain-label {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .chain-text { display: none; font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.45; }
  .chain a:hover { padding-left: var(--space-3); }
  .chain a:hover .chain-label { color: var(--brand-ink); }
  @media (min-width: 1024px) {
    .chain {
      grid-template-columns: repeat(6, 1fr);
      border-top: 0;
      padding-top: var(--space-6);
    }
    .chain::before,
    .chain::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--line);
    }
    .chain::after {
      background: var(--brand);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 1.8s var(--ease);
    }
    .chain.is-drawn::after { transform: scaleX(1); }
    .chain li { border-bottom: 0; border-left: 1px solid var(--line); }
    .chain a { flex-direction: column; gap: var(--space-3); padding: 0 var(--space-4) var(--space-4); min-height: 11rem; }
    .chain .mono { margin-bottom: var(--space-4); }
    .chain-text { display: block; }
    .chain a:hover { padding-left: var(--space-4); background: var(--paper); }
    .chain-label { font-size: var(--fs-md); line-height: 1.2; }
  }

  .experience { border-bottom: 1px solid var(--line); }
  .exp-head { display: grid; gap: var(--space-4); margin-bottom: var(--space-6); }
  .exp-head h2 { max-width: 30ch; }
  .head-aside { display: grid; gap: var(--space-4); justify-items: start; }
  .service-index { border-top: 1px solid var(--line); }

  /* SOLUCIONES A MEDIDA */
  .custom-grid { display: grid; gap: var(--space-7); align-items: center; }
  .custom-copy { display: grid; gap: var(--space-5); justify-items: start; }
  .question {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--brand);
    max-width: 30ch;
    letter-spacing: -0.015em;
  }
  @media (min-width: 1024px) {
    .custom-grid { grid-template-columns: 1.2fr 1fr; gap: var(--space-9); }
  }
</style>
