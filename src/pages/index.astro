---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Photo from '@/components/Photo.astro';
import Stats from '@/components/Stats.astro';
import ServiceIndex from '@/components/ServiceIndex.astro';
import FeaturedCase from '@/components/FeaturedCase.astro';
import TechList from '@/components/TechList.astro';
import SectorList from '@/components/SectorList.astro';
import FlowSteps from '@/components/FlowSteps.astro';
import CertList from '@/components/CertList.astro';
import CtaBand from '@/components/CtaBand.astro';
import VisitSection from '@/components/VisitSection.astro';
import { services, serviceHref } from '@/data/services';
import { methodSteps } from '@/data/navigation';
import { featuredCase } from '@/data/cases';
import { site } from '@/data/site';

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).href, inLanguage: 'es-ES' },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios logísticos de PALEX MEDICAL',
    itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: new URL(serviceHref(s.slug), Astro.site).href })),
  },
];

const pillars = ['Transporte', 'Logística', 'Tecnología', 'Consultoría'];
const specials = ['Embalaje', 'Equipos de alto valor', 'Manipulación especial', 'Transporte', 'Soluciones a medida'];
---
<BaseLayout
  title="Operador logístico B2B"
  fullTitle="Soluciones logísticas integrales para operaciones complejas | PALEX MEDICAL"
  description="Transporte, logística, tecnología y soluciones a medida para operaciones que requieren precisión, trazabilidad y control. Experiencia en logística hospitalaria desde 1998."
  schema={schema}
  overlay
>
  <!-- 01 · HERO -->
  <section class="hero on-dark">
    <Photo image="hero" eager overlay="left" class="hero-bg" parallax />
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>PALEX MEDICAL · Soluciones logísticas</p>
        <h1 data-reveal="mask" style="--reveal-i:1">Soluciones logísticas para operaciones que <em>no pueden fallar.</em></h1>
        <p class="lead" data-reveal style="--reveal-i:2">
          Transporte, logística, tecnología y soluciones a medida para operaciones que requieren precisión, trazabilidad y control.
        </p>
        <div class="btn-row" data-reveal style="--reveal-i:3">
          <a href="/contacto/" class="btn">Solicitar una solución <Icon name="arrow" /></a>
          <a href="#servicios" class="btn btn-ghost">Conocer nuestros servicios</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · DECLARACIÓN -->
  <section class="section statement">
    <div class="container">
      <p class="eyebrow" data-reveal>Más que transporte</p>
      <h2 class="statement-title" data-reveal="mask" style="--reveal-i:1"><em>Más que transporte.</em> Diseñamos y gestionamos soluciones logísticas completas.</h2>
      <ul role="list" class="pillars">
        {pillars.map((p, i) => <li data-reveal style={`--reveal-i:${i + 2}`}>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- 03 · CIFRAS VERIFICADAS -->
  <section class="section tight numbers" aria-label="Experiencia en cifras">
    <div class="container">
      <Stats />
    </div>
  </section>

  <!-- 04 · CAPACIDAD -->
  <section class="capacity">
    <div class="cap-media" data-reveal="scale">
      <Photo image="capacity" sizes="(max-width: 1024px) 100vw, 58vw" parallax />
    </div>
    <div class="cap-copy">
      <p class="eyebrow" data-reveal>Capacidad</p>
      <h2 data-reveal="right" style="--reveal-i:1">Una solución. <em>Todas las fases</em> de la operación.</h2>
      <p class="lead" data-reveal style="--reveal-i:2">
        Combinamos logística, transporte, tecnología, trazabilidad y consultoría para diseñar operaciones adaptadas a cada cliente, y las gestionamos con un único interlocutor.
      </p>
      <p class="muted" data-reveal style="--reveal-i:3">
        Una experiencia formada en el entorno hospitalario, donde cada referencia, cada plazo y cada registro cuentan.
      </p>
      <a href="/empresa/" class="link-arrow" data-reveal style="--reveal-i:4">Conocer la empresa <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- 05 · SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Servicios</p>
          <h2 data-reveal style="--reveal-i:1">Seis líneas de servicio. Una operación coordinada.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">Desde una necesidad puntual hasta la externalización completa de la logística.</p>
      </div>
      <ServiceIndex />
    </div>
  </section>

  <!-- 06 · CASO REAL -->
  <section class="section bg-surface">
    <div class="container">
      <FeaturedCase c={featuredCase} />
    </div>
  </section>

  <!-- 07 · TECNOLOGÍA -->
  <section class="section on-dark tech">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Tecnología</p>
          <h2 data-reveal="mask" style="--reveal-i:1">Tecnología aplicada <em>a la logística.</em></h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Digitalizamos procesos para mejorar la trazabilidad, el control y la eficiencia de las operaciones.
        </p>
      </div>
      <TechList />
      <a href="/tecnologia/" class="link-arrow more" data-reveal>Ver tecnología <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- 08 · SERVICIOS ESPECIALES -->
  <section class="specials on-dark">
    <Photo image="especiales" overlay="full" class="specials-bg" parallax />
    <div class="container specials-inner">
      <p class="eyebrow" data-reveal>Servicios especiales</p>
      <h2 data-reveal="mask" style="--reveal-i:1">Cuando una operación requiere <em>algo diferente.</em></h2>
      <p class="lead" data-reveal style="--reveal-i:2">
        Analizamos las necesidades específicas de cada operación y diseñamos una solución adaptada.
      </p>
      <ul role="list" class="specials-list" data-reveal style="--reveal-i:3">
        {specials.map((s) => <li>{s}</li>)}
      </ul>
      <a href="/servicios/servicios-especiales/" class="link-arrow" data-reveal style="--reveal-i:4">Ver servicios especiales <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- 09 · SECTORES -->
  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Sectores</p>
          <h2 data-reveal style="--reveal-i:1">Necesidades distintas. La misma exigencia.</h2>
        </div>
        <a href="/sectores/" class="link-arrow head-link" data-reveal style="--reveal-i:2">Ver sectores <Icon name="arrow" /></a>
      </div>
      <SectorList />
    </div>
  </section>

  <!-- 10 · PROCESO -->
  <section class="section bg-stone">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Cómo trabajamos</p>
        <h2 data-reveal style="--reveal-i:1">Un método para cada operación.</h2>
      </div>
      <FlowSteps steps={methodSteps} />
    </div>
  </section>

  <!-- 11 · CALIDAD Y CUMPLIMIENTO -->
  <section class="section quality">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Confianza</p>
          <h2 data-reveal style="--reveal-i:1">Calidad y cumplimiento.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-i:2">
          Nuestro compromiso con la calidad, la seguridad y la mejora continua forma parte de nuestra forma de trabajar.
        </p>
      </div>
      <CertList />
    </div>
  </section>

  <!-- 12 · UBICACIÓN Y HORARIO -->
  <VisitSection />

  <!-- 13 · CTA -->
  <CtaBand />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; display: flex; min-height: 100svh; overflow: hidden; }
  .hero :global(.hero-bg) { position: absolute; inset: 0; }
  .hero-inner { position: relative; z-index: 1; display: flex; align-items: flex-end; padding-top: calc(var(--header-h) + var(--space-8)); padding-bottom: clamp(4rem, 3rem + 6vw, 9rem); }
  .hero-copy { display: grid; gap: var(--space-6); justify-items: start; max-width: 70rem; }
  .hero h1 { font-size: clamp(2.75rem, 1.2rem + 6vw, 7.25rem); max-width: 15ch; }
  .hero .lead { max-width: 44ch; color: rgba(255, 255, 255, 0.82); }
  .hero .btn-row { margin-top: var(--space-4); }
  @media (max-width: 560px) {
    .hero .btn-row { width: 100%; }
    .hero .btn-row .btn { flex: 1 1 100%; }
  }

  /* DECLARACIÓN */
  .statement .container { display: grid; gap: var(--space-6); }
  .statement-title { font-size: clamp(2.25rem, 1.3rem + 4vw, 5.5rem); font-weight: 400; max-width: 20ch; }
  .pillars { display: flex; flex-wrap: wrap; gap: var(--space-3) clamp(1.5rem, 1rem + 3vw, 4rem); margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .pillars li { font-size: var(--fs-sm); font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg); }
  .pillars li::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 0.9rem; border-radius: 50%; background: var(--brand); vertical-align: middle; }
  .numbers { padding-top: 0; }

  /* CAPACIDAD */
  .capacity { display: grid; background: var(--surface); }
  .cap-media { position: relative; min-height: 62vw; }
  .cap-media :global(.photo) { position: absolute; inset: 0; }
  .cap-copy { display: grid; gap: var(--space-5); align-content: center; justify-items: start; padding: var(--space-9) var(--gutter); }
  .cap-copy h2 { max-width: 13ch; }
  .cap-copy .muted { max-width: 46ch; }
  .cap-copy .link-arrow { margin-top: var(--space-4); }
  @media (min-width: 1024px) {
    .capacity { grid-template-columns: 7fr 5fr; min-height: 90vh; }
    .cap-media { min-height: 0; }
    .cap-copy { padding: var(--space-9) var(--gutter) var(--space-9) var(--space-9); }
  }

  /* TECNOLOGÍA */
  .tech .more { margin-top: var(--space-7); }

  /* ESPECIALES */
  .specials { position: relative; overflow: hidden; }
  .specials :global(.specials-bg) { position: absolute; inset: 0; }
  .specials-inner { position: relative; z-index: 1; display: grid; gap: var(--space-6); justify-items: start; padding-block: clamp(8rem, 5rem + 12vw, 18rem); }
  .specials h2 { max-width: 14ch; font-size: clamp(2.5rem, 1.4rem + 4.6vw, 6rem); }
  .specials .lead { color: rgba(255, 255, 255, 0.82); }
  .specials-list { display: flex; flex-wrap: wrap; gap: var(--space-3) 0; margin-top: var(--space-4); }
  .specials-list li { font-size: var(--fs-sm); letter-spacing: 0.14em; text-transform: uppercase; color: #fff; }
  .specials-list li + li::before { content: '—'; margin: 0 1rem; opacity: 0.45; }

  .head-link { justify-self: start; }
  @media (min-width: 1024px) { .head-link { justify-self: end; } }
</style>
