---
import Logo from './Logo.astro';
import { serviceLinks, companyLinks, legalLinks } from '@/data/navigation';
import { sectors } from '@/data/sectors';
import { site, telHref } from '@/data/site';

const { contact, social } = site;
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark" id="site-footer">
  <div class="container">
    <div class="top">
      <div class="intro">
        <Logo tone="light" />
        <p>Logística, transporte, tecnología, trazabilidad y consultoría para operaciones complejas.</p>
      </div>
      <nav class="cols" aria-label="Pie de página">
        <div>
          <p class="col-title">Servicios</p>
          <ul role="list">{serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="col-title">Sectores</p>
          <ul role="list">{sectors.map((s) => <li><a href={`/sectores/#${s.slug}`}>{s.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="col-title">Empresa</p>
          <ul role="list">{companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="col-title">Contacto</p>
          <ul role="list" class="contact">
            {[contact.phone, contact.customerService].map((p) => (
              <li><span class="sub">{p.label}</span><a href={telHref(p.number)}>{p.number}</a></li>
            ))}
            {site.locations.map((l) => (
              <li>
                <span class="sub">{l.label}</span>
                <address>{l.address.street}<br />{l.address.postalCode} {l.address.city}</address>
              </li>
            ))}
            {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
            {social.linkedin && <li><a href={social.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>}
          </ul>
        </div>
      </nav>
    </div>
    <div class="bottom">
      <p>© {year} {site.legalName}</p>
      <ul role="list" class="legal">{legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-9) var(--space-6); border-top: 1px solid var(--ink-3); }
  .top { display: grid; gap: var(--space-8); }
  .intro { display: grid; gap: var(--space-5); align-content: start; max-width: 30ch; }
  .intro p { color: var(--text-on-dark-muted); font-size: var(--fs-sm); }
  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-7) var(--space-5); }
  .col-title { margin-bottom: var(--space-4); font-size: var(--fs-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-on-dark-muted); }
  .cols li { margin-bottom: 0.6rem; font-size: var(--fs-sm); }
  .cols a { color: var(--text-on-dark); opacity: 0.8; transition: opacity var(--dur) var(--ease); }
  .cols a:hover { opacity: 1; }
  .contact li { display: grid; margin-bottom: var(--space-4); }
  .sub { font-size: var(--fs-xs); color: var(--text-on-dark-muted); }
  address { font-style: normal; color: var(--text-on-dark); opacity: 0.8; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-9); padding-top: var(--space-5); border-top: 1px solid var(--ink-3); color: var(--text-on-dark-muted); font-size: var(--fs-xs); }
  .legal { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .legal a:hover { color: #fff; }
  @media (min-width: 1024px) {
    .top { grid-template-columns: 1fr 3fr; gap: var(--space-9); }
    .cols { grid-template-columns: repeat(4, 1fr); }
  }
</style>
