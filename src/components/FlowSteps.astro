---
/**
 * Proceso como línea horizontal: número + verbo (+ texto opcional muy breve).
 * La línea se dibuja al entrar en pantalla. Vertical en móvil.
 */
interface Step {
  title: string;
  text?: string;
}
interface Props {
  steps: Step[];
  tone?: 'light' | 'dark';
  showText?: boolean;
}
const { steps, tone = 'light', showText = false } = Astro.props;
---
<ol role="list" class:list={['flow', `flow--${tone}`, { many: steps.length > 5 }]} style={`--n:${steps.length}`} data-draw>
  {steps.map((s, i) => (
    <li style={`--i:${i}`}>
      <span class="dot" aria-hidden="true"></span>
      <span class="num">{String(i + 1).padStart(2, '0')}</span>
      <span class="title">{s.title}</span>
      {showText && s.text && <span class="text">{s.text}</span>}
    </li>
  ))}
</ol>

<style>
  .flow { position: relative; display: grid; gap: var(--space-6); padding-left: 2.25rem; }
  .flow::before, .flow::after { content: ''; position: absolute; left: 4px; top: 8px; bottom: 8px; width: 1px; background: var(--line-strong); }
  .flow::after { background: var(--ink); transform: scaleY(0); transform-origin: top; transition: transform 1.8s var(--ease-out); }
  .flow.is-drawn::after { transform: scaleY(1); }
  li { position: relative; display: grid; gap: 0.4rem; min-width: 0; }
  .many .title { font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem); }
  .dot {
    position: absolute; left: -2.25rem; top: 6px; width: 9px; height: 9px; border-radius: 50%;
    background: var(--paper); border: 1px solid var(--line-strong);
    transition: background 500ms var(--ease), border-color 500ms var(--ease);
    transition-delay: calc(var(--i) * 260ms + 300ms);
  }
  .flow.is-drawn .dot { background: var(--brand); border-color: var(--brand); }
  .num { font-size: var(--fs-sm); color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .title { font-family: var(--font-display); font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.5rem); letter-spacing: -0.035em; line-height: 1.05; color: var(--ink); }
  .text { font-size: var(--fs-sm); color: var(--text-muted); max-width: 28ch; }
  .flow--dark::before { background: var(--ink-3); }
  .flow--dark::after { background: #fff; }
  .flow--dark .dot { background: var(--ink); border-color: var(--ink-3); }
  .flow--dark .num { color: var(--text-on-dark-muted); }
  .flow--dark .title { color: #fff; }
  .flow--dark .text { color: var(--text-on-dark-muted); }

  @media (min-width: 900px) {
    .flow { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--space-5); padding-left: 0; padding-top: 3rem; }
    .flow::before, .flow::after { left: 0; right: 0; top: 4px; bottom: auto; width: auto; height: 1px; }
    .flow::after { transform: scaleX(0); transform-origin: left; }
    .flow.is-drawn::after { transform: scaleX(1); }
    .dot { left: 0; top: -3rem; }
  }
</style>
