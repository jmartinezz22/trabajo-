---
/**
 * [SUSTITUIR] Wordmark tipográfico provisional.
 * La web se presenta como servicio, sin nombre de empresa.
 * (manteniendo `aria-label`). No se ha recreado el logo para no inventar marca.
 */
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`, className]} role="img" aria-label="Soluciones Logísticas">
  <span class="logo__mark" aria-hidden="true"></span>
  <span class="logo__word" aria-hidden="true">Soluciones<span class="logo__sub">Logísticas</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-display);
    line-height: 1;
    color: var(--ink);
  }
  .logo--light { color: #fff; }
  .logo__mark {
    width: 10px;
    height: 32px;
    background: var(--brand);
    border-radius: 1px;
  }
  .logo__word {
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .logo__sub {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.72;
  }
</style>
