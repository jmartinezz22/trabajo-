---
import { technology } from '@/data/technology';

interface Props {
  tone?: 'light' | 'dark';
  showDetail?: boolean;
}
const { tone = 'dark', showDetail = false } = Astro.props;
---
<ul role="list" class:list={['tech', `tech--${tone}`]}>
  {technology.map((t, i) => (
    <li id={showDetail ? t.id : undefined} data-reveal style={`--reveal-i:${i % 4}`}>
      <span class="num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{t.title}</h3>
      <p>{t.text}</p>
    </li>
  ))}
</ul>

<style>
  .tech { display: grid; gap: 0; }
  li { position: relative; display: grid; align-content: start; justify-items: start; gap: var(--space-3); padding: var(--space-5) var(--space-5) var(--space-7) 0; border-top: 1px solid var(--ink); }
  li::before { content: ''; position: absolute; left: 0; top: -1px; width: 100%; height: 2px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform 600ms var(--ease); }
  li:hover::before { transform: scaleX(1); }
  .num { font-size: var(--fs-xs); color: var(--brand-ink); margin-bottom: var(--space-4); }
  h3 { font-size: var(--fs-lg); letter-spacing: -0.02em; }
  p { font-size: var(--fs-sm); color: var(--text-muted); }
  .tech--dark { border-color: var(--ink-3); }
  .tech--dark li { border-color: rgba(255, 255, 255, 0.4); }
  .tech--dark .num { color: #7ff0d4; }
  .tech--dark h3 { color: #fff; }
  .tech--dark p:not(.pending) { color: var(--text-on-dark-muted); }
  @media (min-width: 640px) {
    .tech { grid-template-columns: repeat(2, 1fr); column-gap: var(--space-6); }
  }
  @media (min-width: 1100px) {
    .tech { grid-template-columns: repeat(4, 1fr); }
  }
</style>
