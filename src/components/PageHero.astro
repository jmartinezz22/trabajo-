---
/**
 * Cabecera de página. Con `image`: fotografía de fondo relacionada con el
 * contenido (animación lenta de fondo + parallax); sin imagen: cabecera clara.
 */
import Photo from './Photo.astro';
import type { PhotoKey } from '@/data/images';
import type { Crumb } from '@/layouts/BaseLayout.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  breadcrumbs?: Crumb[];
  image?: PhotoKey;
  caption?: string;
}
const { eyebrow, title, intro, breadcrumbs = [], image } = Astro.props;
---
<section class:list={['page-hero', image ? 'has-photo on-dark' : 'is-plain']}>
  {image && (
    <div class="bg" aria-hidden="true">
      <Photo image={image} eager kenburns sizes="100vw" />
      <div class="shade"></div>
    </div>
  )}
  <div class="container inner">
    {breadcrumbs.length > 0 && (
      <nav aria-label="Ruta de navegación" class="crumbs">
        <ol role="list">
          <li><a href="/">Inicio</a></li>
          {breadcrumbs.map((c, i) => (
            <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class="copy">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 data-reveal style="--reveal-i:1">{title}</h1>
      <p class="lead" data-reveal style="--reveal-i:2">{intro}</p>
      {Astro.slots.has('default') && <div class="btn-row" data-reveal style="--reveal-i:3"><slot /></div>}
    </div>
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; }
  .bg { position: absolute; inset: 0; }
  .bg :global(.photo) { position: absolute; inset: 0; }
  .shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(14, 26, 36, 0.82) 0%, rgba(14, 26, 36, 0.5) 50%, rgba(14, 26, 36, 0.12) 100%),
      linear-gradient(0deg, rgba(14, 26, 36, 0.45) 0%, rgba(14, 26, 36, 0) 40%);
  }
  .inner { position: relative; z-index: 3; }
  .has-photo { background: var(--ink); }
  .has-photo .inner { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-8); min-height: clamp(520px, 74svh, 820px); padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) clamp(3.5rem, 2.5rem + 4vw, 6rem); }
  .is-plain { padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) var(--section-y); border-bottom: 1px solid var(--line); }
  .is-plain .crumbs { margin-bottom: clamp(2.5rem, 2rem + 3vw, 5rem); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .has-photo .crumbs ol { color: rgba(255, 255, 255, 0.82); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; opacity: 0.6; }
  .crumbs a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { color: inherit; font-weight: 500; }
  .copy { display: grid; gap: var(--space-5); justify-items: start; max-width: 54rem; }
  .copy h1 { max-width: 20ch; font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4.5rem); }
  .has-photo .lead { color: rgba(255, 255, 255, 0.86); }
  .copy .btn-row { margin-top: var(--space-3); }
</style>
