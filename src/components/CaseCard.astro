---
/**
 * Plantilla de caso/proyecto. No se publican clientes, cifras ni resultados
 * no confirmados: los textos marcados como pendientes deben sustituirse.
 */
interface Props {
  tag: string;
  title: string;
  problem: string;
  solution: string;
  result: string;
  services: string[];
  index?: number;
}
const { tag, title, problem, solution, result, services, index = 0 } = Astro.props;
---
<article class="case" data-reveal style={`--reveal-i:${index % 3}`}>
  <header>
    <p class="mono tag">{tag}</p>
    <h3>{title}</h3>
    <p class="pending">Caso ilustrativo · Pendiente de sustituir por proyecto real</p>
  </header>
  <dl>
    <div><dt class="mono">Reto</dt><dd>{problem}</dd></div>
    <div><dt class="mono">Solución</dt><dd>{solution}</dd></div>
    <div><dt class="mono">Resultado</dt><dd>{result.startsWith('[') ? <span class="pending">{result}</span> : result}</dd></div>
  </dl>
  <ul role="list" class="chips">
    {services.map((s) => <li>{s}</li>)}
  </ul>
</article>

<style>
  .case {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding: var(--space-6) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  header { display: grid; gap: var(--space-3); justify-items: start; }
  .tag { color: var(--brand-ink); text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--fs-xs); }
  dl { display: grid; gap: var(--space-4); }
  dl > div { display: grid; gap: 0.25rem; padding-top: var(--space-4); border-top: 1px solid var(--line); }
  dt { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); }
  dd { margin: 0; font-size: var(--fs-sm); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chips li { padding: 0.25rem 0.625rem; border: 1px solid var(--line); border-radius: var(--radius-sm); font-size: var(--fs-xs); color: var(--text-muted); }
</style>
