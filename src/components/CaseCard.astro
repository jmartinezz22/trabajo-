---
/**
 * Proyecto pendiente de validación interna: descripción cualitativa,
 * sin cliente, sin cifras y con distintivo visible.
 */
import type { CaseStudy } from '@/data/cases';

interface Props {
  c: CaseStudy;
  index?: number;
}
const { c, index = 0 } = Astro.props;
---
<article class="case" data-reveal style={`--reveal-i:${index % 3}`}>
  <header>
    <p class="mono tag">{c.tag}</p>
    <h3>{c.title}</h3>
    {c.status === 'validation' && <p class="pending">Pendiente de validación interna</p>}
  </header>
  <dl>
    <div><dt class="mono">Reto</dt><dd>{c.problem}</dd></div>
    <div><dt class="mono">Solución</dt><dd>{c.solution}</dd></div>
    <div>
      <dt class="mono">Resultado</dt>
      <dd>{c.results.map((r) => (r.startsWith('[') ? <span class="pending">{r}</span> : <span>{r}</span>))}</dd>
    </div>
  </dl>
  <ul role="list" class="chips">
    {[...c.services, ...c.technologies].map((s) => <li>{s}</li>)}
  </ul>
</article>

<style>
  .case {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    padding: var(--space-6) var(--space-5);
    background: var(--surface);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }
  header { display: grid; gap: var(--space-3); justify-items: start; }
  .tag { color: var(--brand-ink); text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--fs-xs); }
  dl { display: grid; gap: var(--space-4); }
  dl > div { display: grid; gap: 0.25rem; padding-top: var(--space-4); border-top: 1px solid var(--line); }
  dt { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); }
  dd { margin: 0; font-size: var(--fs-sm); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chips li { padding: 0.25rem 0.625rem; border: 1px solid var(--line); border-radius: var(--radius-sm); font-size: var(--fs-xs); color: var(--text-muted); }
</style>
