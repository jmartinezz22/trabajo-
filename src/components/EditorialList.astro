---
/** Lista editorial: título + línea breve, separadas por líneas finas. Sin cajas ni iconos. */
interface Item {
  title: string;
  text?: string;
}
interface Props {
  items: Item[];
  label?: string;
  columns?: 1 | 2;
  tone?: 'light' | 'dark';
}
const { items, label, columns = 2, tone = 'light' } = Astro.props;
---
<div class:list={['ed', `ed--${tone}`]}>
  {label && <p class="eyebrow ed-label">{label}</p>}
  <ul role="list" class:list={['ed-list', `cols-${columns}`]}>
    {items.map((it, i) => (
      <li data-reveal style={`--reveal-i:${i % 2}`}>
        <h3>{it.title}</h3>
        {it.text && <p>{it.text}</p>}
      </li>
    ))}
  </ul>
</div>

<style>
  .ed + .ed { margin-top: var(--space-8); }
  .ed-label { margin-bottom: var(--space-4); }
  .ed-list { border-top: 1px solid var(--line); }
  li { display: grid; gap: var(--space-2); padding: var(--space-5) 0 var(--space-6); border-bottom: 1px solid var(--line); }
  h3 { font-size: var(--fs-lg); font-weight: 500; }
  p { max-width: 46ch; color: var(--text-muted); font-size: var(--fs-base); }
  .ed--dark .ed-list, .ed--dark li { border-color: var(--ink-3); }
  .ed--dark p { color: var(--text-on-dark-muted); }
  @media (min-width: 900px) {
    .cols-2 { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: var(--space-9); border-top: 0; }
    .cols-2 li:nth-child(-n + 2) { border-top: 1px solid var(--line); }
    .ed--dark .cols-2 li:nth-child(-n + 2) { border-color: var(--ink-3); }
    li { grid-template-columns: minmax(0, 1fr); }
  }
</style>
