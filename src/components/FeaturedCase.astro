---
/** Caso real verificado. No añadir cifras ni resultados no publicados. */
import Icon from './Icon.astro';
import Visual from './Visual.astro';
import type { CaseStudy } from '@/data/cases';

interface Props {
  c: CaseStudy;
  headingLevel?: 'h2' | 'h3';
}
const { c, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="featured" id={c.id}>
  <div class="media" data-reveal>
    <Visual image="hospital" ratio="fill" caption="Caso real · imagen ilustrativa" kenburns />
    {c.scope && (
      <div class="scope">
        <span class="mono">Alcance</span>
        <strong>{c.scope}</strong>
      </div>
    )}
  </div>
  <div class="body">
    <p class="mono tag" data-reveal><span class="dot" aria-hidden="true"></span>Caso real · {c.tag}</p>
    <H class="title" data-reveal style="--reveal-i:1">{c.client}</H>
    <p class="subtitle" data-reveal style="--reveal-i:2">{c.title}</p>

    <dl data-reveal style="--reveal-i:3">
      <div><dt class="mono">Reto</dt><dd>{c.problem}</dd></div>
      <div><dt class="mono">Solución</dt><dd>{c.solution}</dd></div>
      <div>
        <dt class="mono">Resultados publicados</dt>
        <dd>
          <ul role="list" class="results">
            {c.results.map((r) => <li><Icon name="check" size={18} />{r}</li>)}
          </ul>
        </dd>
      </div>
    </dl>
    <ul role="list" class="chips">
      {c.technologies.map((t) => <li>{t}</li>)}
    </ul>
    <p class="source mono">Fuente: caso publicado.</p>
  </div>
</article>

<style>
  .featured { display: grid; gap: var(--space-6); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .media { position: relative; min-height: 280px; }
  .media :global(.visual) { border-radius: 0; height: 100%; }
  .scope {
    position: absolute;
    right: 1rem;
    top: 1rem;
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    background: var(--brand);
    color: var(--ink);
    border-radius: var(--radius-sm);
  }
  .scope .mono { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .scope strong { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.02em; line-height: 1; }
  .body { display: grid; gap: var(--space-4); align-content: start; padding: 0 var(--space-5) var(--space-6); }
  .tag { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--brand-ink); text-transform: uppercase; letter-spacing: 0.1em; font-size: var(--fs-xs); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brand); }
  .title { font-size: var(--fs-xl); }
  .subtitle { font-size: var(--fs-md); color: var(--text-muted); }
  dl { display: grid; gap: var(--space-4); margin-top: var(--space-2); }
  dl > div { display: grid; gap: 0.35rem; padding-top: var(--space-4); border-top: 1px solid var(--line); }
  dt { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); }
  dd { margin: 0; font-size: var(--fs-sm); }
  .results { display: grid; gap: 0.4rem; }
  @media (min-width: 640px) { .results { grid-template-columns: repeat(2, 1fr); } }
  .results li { display: grid; grid-template-columns: 18px 1fr; gap: 0.5rem; }
  .results :global(svg) { color: var(--brand-ink); margin-top: 2px; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chips li { padding: 0.25rem 0.625rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font-size: var(--fs-xs); font-weight: 500; }
  .source { font-size: 0.6875rem; color: var(--text-muted); }
  @media (min-width: 1024px) {
    .featured { grid-template-columns: 5fr 7fr; gap: var(--space-8); }
    .media { min-height: 100%; }
    .body { padding: var(--space-7) var(--space-7) var(--space-7) 0; }
  }
</style>
