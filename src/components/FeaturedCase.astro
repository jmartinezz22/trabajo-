---
/** Caso real verificado en composición editorial. Solo resultados publicados. */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import type { CaseStudy } from '@/data/cases';

interface Props {
  c: CaseStudy;
  /** En la página del proyecto no se repite el enlace. */
  link?: boolean;
  title?: string;
}
const { c, link = true, title = '176 almacenes. Un hospital. Trazabilidad de extremo a extremo.' } = Astro.props;
---
<article class="case" id={c.id}>
  <div class="media" data-reveal="left">
    <Photo image="hospital" label sizes="(max-width: 1024px) 100vw, 50vw" parallax />
  </div>
  <div class="body">
    <p class="eyebrow" data-reveal>Caso de éxito · {c.client}</p>
    <h2 data-reveal style="--reveal-i:1">{title}</h2>
    <p class="lead" data-reveal style="--reveal-i:2">{c.solution}</p>

    <dl class="facts" data-reveal style="--reveal-i:3">
      <div><dt>Alcance</dt><dd>176 <span>almacenes</span></dd></div>
      <div><dt>Tecnología</dt><dd>RFID</dd></div>
      <div><dt>Soluciones</dt><dd>Dyane</dd></div>
    </dl>

    <div class="results" data-reveal style="--reveal-i:4">
      <p class="eyebrow">Resultados publicados</p>
      <ul role="list">
        {c.results.map((r) => <li>{r}</li>)}
      </ul>
    </div>

    {link && (
      <div data-reveal style="--reveal-i:5">
        <a href={`/proyectos/${c.id}/`} class="btn">Ver proyecto <Icon name="arrow" /></a>
      </div>
    )}
  </div>
</article>

<style>
  .case { display: grid; gap: var(--space-7); }
  .media { position: relative; min-height: 420px; }
  .media :global(.photo) { position: absolute; inset: 0; }
  .body { display: grid; gap: var(--space-6); align-content: center; justify-items: start; }
  .body h2 { font-size: clamp(2.25rem, 1.4rem + 3.2vw, 4.5rem); max-width: 14ch; }
  .facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: var(--space-7); width: 100%; padding-block: var(--space-5); border-block: 1px solid var(--line); }
  .facts dt { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-muted); }
  .facts dd { margin: var(--space-2) 0 0; font-family: var(--font-display); font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.75rem); letter-spacing: -0.04em; line-height: 1; color: var(--fg); }
  .facts dd span { font-size: 0.45em; letter-spacing: -0.01em; color: var(--text-muted); }
  .results { display: grid; gap: var(--space-4); width: 100%; }
  .results ul { display: grid; }
  .results li { padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .results li::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 0.85rem; border-radius: 50%; background: var(--brand); vertical-align: middle; }
  @media (min-width: 1024px) {
    .case { grid-template-columns: 1fr 1fr; gap: var(--space-9); align-items: stretch; }
    .media { min-height: 760px; }
    .results ul { grid-template-columns: 1fr 1fr; column-gap: var(--space-6); }
  }
</style>
