---
/**
 * Franja fotográfica a sangre con texto superpuesto.
 * La fotografía es parte de la composición: ocupa toda la anchura, se desplaza
 * con parallax lento y el titular se descubre al entrar en pantalla.
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import type { PhotoKey } from '@/data/images';

interface Props {
  image: PhotoKey;
  eyebrow: string;
  /** Admite <em> para el acento tipográfico. */
  title: string;
  text?: string;
  items?: string[];
  href?: string;
  linkLabel?: string;
  align?: 'left' | 'right';
  num?: string;
}
const { image, eyebrow, title, text, items = [], href, linkLabel = 'Ver más', align = 'left', num } = Astro.props;
---
<section class:list={['band on-dark', `band--${align}`]}>
  <Photo image={image} class="band-bg" parallax sizes="100vw" />
  <div class="band-shade" aria-hidden="true"></div>
  <div class="container band-inner">
    <div class="band-copy">
      <p class="eyebrow" data-reveal>{num && <span class="band-num">{num}</span>}{eyebrow}</p>
      <h2 data-reveal="mask" style="--reveal-i:1" set:html={title} />
      {text && <p class="lead" data-reveal style="--reveal-i:2">{text}</p>}
      {items.length > 0 && (
        <ul role="list" class="band-items" data-reveal style="--reveal-i:3">
          {items.map((it) => <li>{it}</li>)}
        </ul>
      )}
      {href && (
        <a href={href} class="link-arrow" data-reveal style="--reveal-i:4">{linkLabel} <Icon name="arrow" /></a>
      )}
    </div>
  </div>
</section>

<style>
  .band { position: relative; display: flex; align-items: flex-end; min-height: clamp(560px, 92svh, 980px); overflow: hidden; }
  .band :global(.band-bg) { position: absolute; inset: 0; }
  .band-shade { position: absolute; inset: 0; z-index: 1; }
  .band--left .band-shade { background: linear-gradient(90deg, rgba(8, 11, 13, 0.88) 0%, rgba(8, 11, 13, 0.5) 50%, rgba(8, 11, 13, 0.05) 100%), linear-gradient(0deg, rgba(8, 11, 13, 0.6), rgba(8, 11, 13, 0) 50%); }
  .band--right .band-shade { background: linear-gradient(270deg, rgba(8, 11, 13, 0.88) 0%, rgba(8, 11, 13, 0.5) 50%, rgba(8, 11, 13, 0.05) 100%), linear-gradient(0deg, rgba(8, 11, 13, 0.6), rgba(8, 11, 13, 0) 50%); }
  .band-inner { position: relative; z-index: 2; display: flex; padding-block: clamp(5rem, 3rem + 8vw, 10rem); }
  .band--right .band-inner { justify-content: flex-end; }
  .band-copy { display: grid; gap: var(--space-5); justify-items: start; max-width: 40rem; }
  .band-copy h2 { font-size: clamp(2.5rem, 1.4rem + 4.4vw, 6rem); max-width: 13ch; }
  .band-copy .lead { color: rgba(243, 245, 244, 0.84); max-width: 40ch; }
  .band-num { margin-right: 0.75rem; color: rgba(243, 245, 244, 0.6); }
  .band-items { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-top: var(--space-2); }
  .band-items li { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; }
  .band-items li::before { content: ''; display: inline-block; width: 4px; height: 4px; margin-right: 0.7rem; border-radius: 50%; background: var(--accent); vertical-align: middle; }
  .band-copy .link-arrow { margin-top: var(--space-3); }
  @media (max-width: 760px) {
    .band--left .band-shade, .band--right .band-shade { background: linear-gradient(0deg, rgba(8, 11, 13, 0.92) 0%, rgba(8, 11, 13, 0.55) 55%, rgba(8, 11, 13, 0.2) 100%); }
    .band--right .band-inner { justify-content: flex-start; }
  }
</style>
