---
/**
 * Servicios en franjas horizontales.
 * Escritorio: al pasar el ratón cambia la imagen fija de la derecha, aparece la descripción y la flecha.
 * Móvil: franjas con imagen y descripción siempre visibles.
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { services, serviceHref } from '@/data/services';
---
<div class="svc" data-svc>
  <ol role="list" class="rows">
    {services.map((s, i) => (
      <li data-reveal style={`--reveal-i:${i % 3}`}>
        <a href={serviceHref(s.slug)} class="row photo-hover" data-svc-item={i}>
          <span class="num">{s.num}</span>
          <span class="name">{s.name}</span>
          <span class="desc">{s.short}</span>
          <span class="go" aria-hidden="true"><Icon name="arrow" size={22} /></span>
          <span class="thumb" aria-hidden="true"><Photo image={s.image} sizes="(max-width: 1100px) 100vw, 1px" zoom /></span>
        </a>
      </li>
    ))}
  </ol>
  <div class="stage" aria-hidden="true">
    {services.map((s, i) => (
      <div class:list={['frame', { 'is-on': i === 0 }]} data-svc-frame={i}>
        <Photo image={s.image} sizes="(max-width: 1100px) 1px, 40vw" />
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
    const frames = root.querySelectorAll<HTMLElement>('[data-svc-frame]');
    const show = (i: string) => frames.forEach((f) => f.classList.toggle('is-on', f.dataset.svcFrame === i));
    root.querySelectorAll<HTMLElement>('[data-svc-item]').forEach((el) => {
      const i = el.dataset.svcItem!;
      el.addEventListener('mouseenter', () => show(i));
      el.addEventListener('focus', () => show(i));
    });
  });
</script>

<style>
  .svc { display: grid; gap: var(--space-8); }
  .rows { border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    grid-template-areas: 'num name go' 'thumb thumb thumb' '. desc desc';
    gap: var(--space-4) var(--space-3);
    align-items: baseline;
    padding: var(--space-6) 0;
  }
  .num { grid-area: num; font-size: var(--fs-sm); color: var(--text-soft); font-variant-numeric: tabular-nums; }
  .name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--fg);
    transition: transform 500ms var(--ease-out), color var(--dur) var(--ease);
  }
  .desc { grid-area: desc; max-width: 46ch; font-size: var(--fs-sm); color: var(--text-muted); }
  .go { grid-area: go; align-self: center; color: var(--fg); transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .thumb { grid-area: thumb; position: relative; display: block; aspect-ratio: 16 / 9; }
  .thumb :global(.photo) { position: absolute; inset: 0; }
  .stage { display: none; }

  @media (min-width: 1100px) {
    .svc { grid-template-columns: 7fr 5fr; gap: var(--space-9); align-items: start; }
    .row {
      grid-template-columns: 4rem 1fr 2.5rem;
      grid-template-areas: 'num name go' '. desc .';
      row-gap: 0;
      padding: var(--space-6) 0;
    }
    .thumb { display: none; }
    .desc {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 500ms var(--ease-out), opacity 400ms var(--ease), margin 500ms var(--ease-out);
    }
    .go { opacity: 0; transform: translateX(-12px); }
    .row:hover .name, .row:focus-visible .name { transform: translateX(10px); }
    .row:hover .desc, .row:focus-visible .desc { max-height: 6rem; opacity: 1; margin-top: var(--space-3); }
    .row:hover .go, .row:focus-visible .go { opacity: 1; transform: none; color: var(--brand-ink); }
    .stage { display: block; position: sticky; top: calc(var(--header-h) + var(--space-6)); aspect-ratio: 4 / 5; }
    .frame { position: absolute; inset: 0; opacity: 0; transform: scale(1.03); transition: opacity 700ms var(--ease), transform 1.2s var(--ease-out); }
    .frame.is-on { opacity: 1; transform: none; }
    .frame :global(.photo) { position: absolute; inset: 0; }
  }
</style>
