---
/** Servicios de una categoría: lista editorial o mosaico visual. */
import Photo from '@/components/Photo.astro';
import { catalogPath, type CatalogConfig } from '@/data/catalog/config';
import { getCategory, localize, type CatalogItem } from '@/data/catalog/content';

interface Props {
  b: CatalogConfig;
  items: CatalogItem[];
  variant?: 'list' | 'mosaic';
}
const { b, items, variant = 'list' } = Astro.props;
const href = (it: CatalogItem) => catalogPath(b, getCategory(it.category).slug, it.slug);
---
{variant === 'mosaic' ? (
  <ul role="list" class="mosaic">
    {items.map((raw, i) => {
      const it = localize(raw, b.showBranding);
      return (
        <li class="mosaic__item" data-rv data-rv-img style={`--i:${i % 4}`}>
          <Photo image={it.image} sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} />
          <div class="mosaic__body">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="d-title mosaic__name"><a href={href(it)}>{it.name}</a></h3>
            <p class="mosaic__text">{it.summary}</p>
          </div>
        </li>
      );
    })}
  </ul>
) : (
  <ol role="list" class="svc-list">
    {items.map((raw, i) => {
      const it = localize(raw, b.showBranding);
      return (
        <li class="svc" data-rv style={`--i:${i % 4}`}>
          <a href={href(it)} class="svc__link">
            <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="d-title svc__name">{it.name}</span>
            <span class="svc__text">{it.summary}</span>
            <span class="svc__thumb" aria-hidden="true"><Photo image={it.image} sizes="200px" /></span>
          </a>
        </li>
      );
    })}
  </ol>
)}
