---
/** Índice visual de categorías. */
import Photo from '@/components/Photo.astro';
import { catalogPath, type CatalogConfig } from '@/data/catalog/config';
import { categories, itemsOf } from '@/data/catalog/content';

interface Props {
  b: CatalogConfig;
}
const { b } = Astro.props;
---
<ol role="list" class="index">
  {categories.map((c, i) => {
    const n = itemsOf(c.key).length;
    return (
      <li class="index__row" data-rv style={`--i:${i % 4}`}>
        <a href={catalogPath(b, c.slug)} class="index__link">
          <span class="index__num" aria-hidden="true">{c.num}</span>
          <span class="d-title index__name">{c.name}</span>
          <span class="index__tag">{c.tagline}</span>
          <span class="index__meta">
            <span class="index__count">{String(n).padStart(2, '0')} {n === 1 ? 'servicio' : 'servicios'}</span>
            <span class="index__thumb" aria-hidden="true"><Photo image={c.image} sizes="170px" /></span>
          </span>
        </a>
      </li>
    );
  })}
</ol>
