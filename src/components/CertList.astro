---
/**
 * Calidad y cumplimiento: composición limpia en filas.
 * GDP no se muestra (no confirmada). Las certificaciones en validación
 * llevan el marcador pendiente y no muestran logotipos.
 */
import { certifications } from '@/data/trust';

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
const shown = certifications.filter((c) => c.status !== 'not-found');
---
<ul role="list" class="certs">
  {shown.map((c, i) => (
    <li data-reveal style={`--reveal-i:${i}`}>
      <span class="code">{c.code}</span>
      <span class="meta">
        <span class="name">{c.name}</span>
        {detailed && c.status === 'validation' && <span class="note">{c.note}</span>}
        {c.status === 'validation' && <span class="pending">[CERTIFICACIÓN PENDIENTE DE VALIDACIÓN]</span>}
      </span>
    </li>
  ))}
</ul>

<style>
  .certs { border-top: 1px solid var(--rule); }
  li { display: grid; gap: var(--space-2); padding: var(--space-6) 0; border-bottom: 1px solid var(--line); }
  .code { font-family: var(--font-display); font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.75rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.05; color: var(--fg); white-space: nowrap; }
  .meta { display: grid; gap: 0.35rem; justify-items: start; }
  .name { color: var(--text); }
  .note { font-size: var(--fs-xs); color: var(--text-soft); }
  .pending { font-size: 0.6875rem; letter-spacing: 0.04em; }
  @media (min-width: 900px) {
    li { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: baseline; column-gap: var(--space-6); }
  }
</style>
