---
import Icon from './Icon.astro';
import { site, telHref } from '@/data/site';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  eyebrow = '¿Hablamos de tu proyecto?',
  title,
  text,
  href = '/contacto/',
  label = 'Solicitar propuesta',
} = Astro.props;
---
<section class="cta-band on-dark">
  <div class="container inner">
    <div class="copy" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {text && <p class="lead">{text}</p>}
    </div>
    <div class="actions" data-reveal style="--reveal-i:1">
      <a href={href} class="btn">{label} <Icon name="arrow" /></a>
      {site.contact.phone && (
        <a href={telHref(site.contact.phone)} class="btn btn-ghost"><Icon name="phone" /> {site.contact.phone}</a>
      )}
    </div>
  </div>
  <svg class="lines" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 260 C 300 260, 380 120, 640 120 S 1000 40, 1200 40" />
    <path d="M0 290 C 340 290, 420 180, 700 180 S 1020 110, 1200 110" />
  </svg>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; padding-block: clamp(4rem, 3rem + 5vw, 7.5rem); }
  .inner { position: relative; z-index: 1; display: grid; gap: var(--space-6); align-items: end; }
  .copy { display: grid; gap: var(--space-4); }
  .copy h2 { max-width: 20ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .lines { position: absolute; inset: auto 0 0 0; width: 100%; height: 60%; opacity: 0.5; }
  .lines path { fill: none; stroke: var(--brand); stroke-width: 1; stroke-dasharray: 3 7; vector-effect: non-scaling-stroke; }
  .lines path + path { stroke: rgba(255, 255, 255, 0.18); }
  @media (min-width: 960px) {
    .inner { grid-template-columns: 1.6fr 1fr; }
    .actions { justify-content: flex-end; }
  }
</style>
