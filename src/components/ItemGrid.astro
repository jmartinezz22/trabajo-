---
/**
 * Prestaciones de un servicio en formato editorial (sin iconos ni tarjetas):
 * etiqueta de grupo a la izquierda y filas numeradas con línea fina a la derecha.
 * Al pasar el cursor, la fila marca el acento y desplaza ligeramente el título.
 */
import type { ServiceItem } from '@/data/services';

interface Props {
  items: ServiceItem[];
  label?: string;
  /** Se mantiene por compatibilidad; el formato editorial no usa columnas. */
  columns?: 3 | 4;
}
const { items, label } = Astro.props;
---
<div class="item-group">
  {label && (
    <div class="group-head" data-reveal>
      <p class="group-label">{label}</p>
      <span class="group-count mono">{String(items.length).padStart(2, '0')} {items.length === 1 ? 'opción' : 'opciones'}</span>
    </div>
  )}
  <ol role="list" class="items">
    {items.map((item, i) => (
      <li class="item" data-reveal style={`--reveal-i:${i % 4}`}>
        <span class="num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .item-group { display: grid; gap: var(--space-5); }
  .item-group + .item-group { margin-top: clamp(3rem, 2rem + 3vw, 5rem); }

  .group-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .group-label {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .group-count { font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }

  .items { border-top: 1px solid var(--ink); }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5) 0 var(--space-6);
    border-bottom: 1px solid var(--line);
  }
  /* Línea de acento que crece al pasar el cursor */
  .item::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 100%;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease);
  }
  .item:hover::before { transform: scaleX(1); }
  .num { grid-row: span 2; padding-top: 0.35rem; font-size: var(--fs-xs); color: var(--brand-ink); }
  .item h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    transition: transform var(--dur) var(--ease);
  }
  .item:hover h3 { transform: translateX(4px); }
  .item p { max-width: 52ch; font-size: var(--fs-base); color: var(--text-muted); }

  @media (min-width: 900px) {
    .item-group { grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr); gap: var(--space-8); align-items: start; }
    .group-head { position: sticky; top: calc(var(--header-h) + var(--space-5)); flex-direction: column; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--ink); }
    .item-group:not(:has(.group-head)) .items { grid-column: 1 / -1; }
    .item { grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.25fr); align-items: baseline; padding: var(--space-6) 0; }
    .num { grid-row: auto; padding-top: 0; }
  }
</style>
