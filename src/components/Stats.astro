---
/**
 * Cifras destacadas. SOLO datos verificados (docs/03-registro-de-datos.md).
 * Sin JavaScript se muestra el valor final.
 */
import { site } from '@/data/site';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;

const stats = [
  { prefix: '+', count: 25, suffix: ' años', label: `Experiencia en soluciones de logística hospitalaria (desde ${site.hospitalLogisticsSince}).` },
  { count: 176, label: 'Almacenes gestionados en un proyecto hospitalario: Hospital Sant Joan de Déu, Barcelona.' },
  { text: 'SAP HANA / EWM', label: 'Experiencia en digitalización logística e implantación en centros propios.' },
];
---
<dl class:list={['stats', `stats--${tone}`]}>
  {stats.map((s, i) => (
    <div class="stat" data-reveal style={`--reveal-i:${i}`}>
      <dt class="visually-hidden">{s.label}</dt>
      <dd class="figure" aria-hidden="true">
        {'count' in s ? (
          <>{s.prefix}<span data-count={s.count}>{s.count}</span>{s.suffix && <span class="suffix">{s.suffix}</span>}</>
        ) : (
          <span class="word">{s.text}</span>
        )}
      </dd>
      <dd class="label">{s.label}</dd>
    </div>
  ))}
</dl>

<style>
  .stats { display: grid; gap: var(--space-7); }
  .stat { display: grid; gap: var(--space-4); align-content: start; padding-top: var(--space-5); border-top: 1px solid var(--line); }
  dd { margin: 0; }
  .figure {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2rem + 5vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .suffix { font-size: 0.32em; letter-spacing: -0.01em; margin-left: 0.2em; }
  .word { display: block; font-size: 0.48em; letter-spacing: -0.035em; line-height: 1.05; padding-top: 0.35em; }
  .label { max-width: 30ch; font-size: var(--fs-sm); color: var(--text-muted); }
  .stats--dark .stat { border-color: var(--ink-3); }
  .stats--dark .figure { color: #fff; }
  .stats--dark .label { color: var(--text-on-dark-muted); }
  @media (min-width: 900px) { .stats { grid-template-columns: repeat(3, 1fr); column-gap: var(--space-8); } }
</style>
