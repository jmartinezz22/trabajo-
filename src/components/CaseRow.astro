---
/** Proyecto pendiente de validación interna: fila editorial, sin cliente ni cifras. */
import type { CaseStudy } from '@/data/cases';

interface Props {
  c: CaseStudy;
  index?: number;
}
const { c, index = 0 } = Astro.props;
---
<li class="row" data-reveal style={`--reveal-i:${index % 3}`}>
  <p class="eyebrow">{c.tag}</p>
  <h3>{c.title}</h3>
  <p class="desc">{c.solution}</p>
  {c.status === 'validation' && <p class="pending">Pendiente de validación interna</p>}
</li>

<style>
  .row { display: grid; gap: var(--space-3); padding: var(--space-6) 0; border-bottom: 1px solid var(--line); }
  h3 { font-size: var(--fs-xl); font-weight: 400; letter-spacing: -0.03em; }
  .desc { max-width: 56ch; color: var(--text-muted); }
  .pending { font-size: var(--fs-xs); justify-self: start; }
  @media (min-width: 1024px) {
    .row { grid-template-columns: 14rem 1fr 18rem; align-items: baseline; column-gap: var(--space-7); }
    .pending { justify-self: end; }
    .desc { grid-column: 2; }
    .row > .pending { grid-column: 3; grid-row: 1; }
  }
</style>
